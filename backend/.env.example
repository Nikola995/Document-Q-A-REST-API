# Local dev (uvicorn outside Docker): redis://localhost:6379  <- already the default, no override needed
# Full Docker: redis://redis:6379
# Production with auth: redis://:yourpassword@host:port
REDIS_URL=redis://redis:6379

# Models — changing these requires a rebuild (docker compose up --build)
QA_MODEL=distilbert-base-cased-distilled-squad
EMBEDDING_MODEL=all-MiniLM-L6-v2
NER_MODEL=fastino/gliner2-base-v1